@model Service
<form method="post" >
    <div class="border mx-auto rounded shadow-sm w-75">
        <div class="card-header rounded-top bg-dark">
           <h2 class="text-light p-3">New Service</h2> 
        </div>
        <div class="card-body px-3">
            <div class="mb-1 row p-2">
                <label asp-for="ServiceName" class="p-0"></label>
                <input asp-for="ServiceName" type="text" class="form-control">
                <span asp-validation-for="ServiceName" class="text-danger"></span>
            </div>

            <div class="btn-group w-100 my-2" role="group" aria-label="Basic radio toggle button group">
                <input type="radio" class="btn-check" asp-for="IsAvailable" value="True" id="btnradio1"
                    autocomplete="off" checked>
                <label for="btnradio1" class="btn btn-outline-success">Available</label>
                <input type="radio" class="btn-check" asp-for="IsAvailable" value="False" id="btnradio2"
                    autocomplete="off">
                <label for="btnradio2" class="btn btn-outline-warning">Not Available</label>
            </div>

            <div class="mb-4 row p-2">
                <label asp-for="Description" class="p-0"></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
        <div class="card-footer  bg-dark-subtle p-2">
            <div class="row justify-content-end gx-2">
                <div class="col-6 col-md-3">
                    <a asp-controller="Service" asp-action="Index" class="btn btn-secondary bg-white text-black w-100">
                        Back to List
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Add Service</button>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}